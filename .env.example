BOT_TOKEN=

# Public Blitz HTTPS address used to register Telegram webhook automatically.
WEBHOOK_BASE_URL=https://abdullahaliraqi.blitz.cloud
# Optional Telegram webhook secret header validation.
WEBHOOK_SECRET=

# Cloud Bot API limit.
TELEGRAM_MAX_UPLOAD_MB=50

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DOWNLOAD_ROOT=/data/downloads

# Optional generic proxy for non-YouTube platforms.
YTDLP_PROXY_URL=

# Optional YouTube-specific proxy.
YOUTUBE_PROXY_URL=

# Optional routable IPv6 block setting understood by the downloader.
YOUTUBE_IPV6_BLOCK=

# Optional Netscape-format cookie file. The repository ships only a placeholder.
YTDLP_COOKIES_FILE=/app/cookies.txt

# Keep true in Blitz/Gunicorn production. Set false for unit tests.
TELEGRAM_RUNTIME_AUTOSTART=true

HOST=0.0.0.0
PORT=8000
