BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Blitz single-container deployment uses local loopback services.
TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
TELEGRAM_LOCAL_MODE=true
TELEGRAM_MAX_UPLOAD_MB=2000

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DOWNLOAD_ROOT=/data/downloads

# Optional general yt-dlp proxy for non-YouTube platforms.
YTDLP_PROXY_URL=

# YouTube-specific stable egress. Use a stable residential/ISP proxy when the
# hosting IP is blocked. Do not rotate identity per request.
YOUTUBE_PROXY_URL=

# Alternative when the host has a routable IPv6 prefix.
YOUTUBE_IPV6_BLOCK=

# Optional native yt-dlp fallback cookies.
YTDLP_COOKIES_DIR=./.secrets
YTDLP_COOKIES_FILE=

# For Blitz, the entrypoint generates and persists a 16-character secret
# automatically under /data/youtube-companion unless this variable is set.
YOUTUBE_COMPANION_SECRET_KEY=

YOUTUBE_COMPANION_BASE_URL=http://127.0.0.1:8282/companion

WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Legacy setting retained only for compatibility with older local deployments.
PIPED_API_URLS=
