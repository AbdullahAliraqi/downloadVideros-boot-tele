BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_LOCAL_MODE=true
TELEGRAM_MAX_UPLOAD_MB=2000

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DOWNLOAD_ROOT=/data/downloads

# Optional general yt-dlp proxy for non-YouTube platforms.
YTDLP_PROXY_URL=

# YouTube-specific stable egress. Use a stable residential/ISP proxy when the
# VPS datacenter IP is blocked. Do not rotate identity per request.
YOUTUBE_PROXY_URL=

# Alternative to a proxy when the VPS has a routable IPv6 prefix.
YOUTUBE_IPV6_BLOCK=

# Optional native yt-dlp fallback cookies.
# The host directory below is mounted to /run/secrets inside the bot container.
YTDLP_COOKIES_DIR=./.secrets
# Set this only when the file exists inside the mounted directory, e.g.
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
YTDLP_COOKIES_FILE=

# Required: exactly 16 random characters. Used only on the internal Companion network.
YOUTUBE_COMPANION_SECRET_KEY=

# Internal default; normally do not change.
YOUTUBE_COMPANION_BASE_URL=http://youtube-companion:8282/companion

WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Deprecated legacy fallback; no public Piped instance is assumed.
PIPED_API_URLS=
